box firstOf <- function(list)
    return list[0]
end

box passByValue <- function(n)
    box list <- []
    count i from 1 to n do
        list:append(i)
    end

    box acc <- 0
    count k from 1 to 100 do
        acc <- acc + firstOf(list)
    end
    return acc
end

box start <- clock()
print(passByValue(100000))
print(clock() - start)
