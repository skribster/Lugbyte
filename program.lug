count a from 0 to 5 do
    match a
        case 0 
            print("Zero")
        end

        case 1 
            print("One")
        end

        case 2 
            print("Two")
        end

        case 3
            print("Three")
        end

        case 4
            print("Four")
        end

        case 5
            print("Five")
        end
    end
end