box name <- "Mary"

inspect name
    when "Mary"
    when "John" 
    when "Dave" do
        print "good friend"
    end

    when "Bob"
    when "Ashley"
    when "Tom" do
        print "bad friend"
    end

    when "Mark" do
        print "best friend"
    end

    else
        print "i don't know who you are"
    end
end