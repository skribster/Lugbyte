box Expr <- thing


Expr.Binary <- function(left, operator, right)
    box binaryExpr <- thing
    
    binaryExpr.left <- left
    binaryExpr.operator <- operator
    binaryExpr.right <- right
    binaryExpr.accept <- function(shared self, visitor)
        return visitor:visitBinaryExpr(self)
    end

    return binaryExpr
end


Expr.Grouping <- function(expression)
    box groupingExpr <- thing

    groupingExpr.expression <- expression
    groupingExpr.accept <- function(shared self, visitor)
        return visitor:visitGroupingExpr(self)
    end

    return groupingExpr
end


Expr.Literal <- function(value)
    box literalExpr <- thing

    literalExpr.value <- value
    literalExpr.accept <- function(shared self, visitor)
        return visitor:visitLiteralExpr(self)
    end
    
    return literalExpr
end


Expr.Unary <- function(operator, right)
    box unaryExpr <- thing

    unaryExpr.operator <- operator
    unaryExpr.right <- right
    unaryExpr.accept <- function(shared self, visitor)
        return visitor:visitUnaryExpr(self)
    end

    return unaryExpr
end


return Expr